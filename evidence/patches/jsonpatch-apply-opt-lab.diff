+def _json_deepcopy(obj, memo=None):
+    """Deep-copies a JSON-shaped document faster than :func:`copy.deepcopy`.
+
+    Documents parsed from JSON consist only of ``dict``, ``list``, ``str``,
+    ``int``, ``float``, ``bool`` and ``None``, for which ``copy.deepcopy``
+    pays the generic dispatch, reduction and ``_keep_alive`` machinery.  This
+    function copies exactly those types directly and defers everything else
+    (subclasses, tuples, sets, custom objects) to ``copy.deepcopy`` with the
+    same memo, so aliasing and cycles are preserved in all cases.
+    """
+    cls = type(obj)
+    if cls is str or cls is int or cls is float or cls is bool or obj is None:
+        return obj
+    if memo is None:
+        memo = {}
+    key = id(obj)
+    if key in memo:
+        return memo[key]
+    if cls is dict:
+        result = {}
+        memo[key] = result
+        for name, value in obj.items():
+            result[_json_deepcopy(name, memo)] = _json_deepcopy(value, memo)
+        return result
+    if cls is list:
+        result = []
+        memo[key] = result
+        for value in obj:
+            result.append(_json_deepcopy(value, memo))
+        return result
+    return copy.deepcopy(obj, memo)
+
